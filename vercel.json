{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page"
    },
    {
      "source": "/asset/:n",
      "destination": "/api/asset?n=:n"
    },
    {
      "source": "/o/:id/:f",
      "destination": "/api/ordner?id=:id&f=:f"
    },
    {
      "source": "/o/:id",
      "destination": "/api/ordner?id=:id"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 5 * * *"
    }
  ],
  "functions": {
    "api/page.js": {
      "maxDuration": 30,
      "includeFiles": "app/**"
    },
    "api/ordner.js": {
      "maxDuration": 30,
      "includeFiles": "public/ordner/**"
    },
    "api/aushang.js": {
      "maxDuration": 30,
      "includeFiles": "api/_tpl/**"
    },
    "api/*.js": {
      "maxDuration": 30
    }
  }
}