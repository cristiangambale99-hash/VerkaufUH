{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page"
    },
    {
      "source": "/asset/:n",
      "destination": "/api/asset?n=:n"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 5 * * *"
    }
  ],
  "functions": {
    "api/page.js": {
      "maxDuration": 30,
      "includeFiles": "app/**"
    },
    "api/*.js": {
      "maxDuration": 30
    }
  }
}
